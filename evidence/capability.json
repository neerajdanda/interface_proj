          "frame": "Member workspace",
          "strategies": [
            {
              "kind": "row",
              "label": "Member ID",
              "control": "input"
            }
          ]
        },
        "value": {
          "param": "member_id"
        }
      },
      "before": [
        {
          "target": {
            "frame": "Member workspace",
            "strategies": [
              {
                "kind": "role",
                "role": "heading",
                "name": "Find a member"
              }
            ]
          },
          "op": "visible"
        }
      ],
      "after": [],
