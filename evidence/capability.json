{
  "schemaVersion": "1.0.0",
  "id": "member-savings.lookup",
  "name": "Member savings lookup",
  "description": "Search for a member and return the verified savings balance through the legacy UI.",
  "vendor": {
    "product": "Relay Ledger",
    "version": "1"
  },
  "entry": {
    "path": "/bank",
    "frame": "Member workspace"
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "sensitive": true
    }
  },
  "outputs": {
    "savings_balance": {
      "type": "money",
      "sensitive": true,
      "target": {
        "frame": "Member workspace",
        "strategies": [
          {
            "kind": "row",
            "label": "Savings balance",
            "control": "text"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "id": "step-1",
      "action": {
        "type": "fill",
